{
  "name": "fe-agent-benchmark-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",

    "lint": "eslint . --max-warnings=0",

    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",

    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",

    "test": "vitest run",

    "test:watch": "vitest",

    "test:e2e": "playwright test",

    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",

    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.1",
    "happy-dom": "^20.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
