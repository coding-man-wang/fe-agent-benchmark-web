{
  "compilerOptions": {
    "target": "ES2022",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "types": [
      "node",
      "@playwright/test"
    ]
  },

  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts"
  ]
}