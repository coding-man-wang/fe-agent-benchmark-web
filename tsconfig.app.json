{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "types": [
      "vite/client",
      "vitest/globals"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",

    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",

    "src/**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "tests/e2e",
    "playwright.config.ts"
  ]
}